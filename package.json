{
    "name": "matrix-system",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/bernardr27/matrixsystem.git"
    },
    "bugs": {
        "url": "https://github.com/bernardr27/matrixsystem/issues"
    },
    "homepage": "https://github.com/bernardr27/matrixsystem#readme",
    "packageManager": "npm@11.6.2",
    "scripts": {
        "start": "launchers\\start.bat",
        "stop": "launchers\\stop.bat",
        "clean": "powershell -ExecutionPolicy Bypass -File scripts\\clean_all.ps1",
        "clean:workspaces": "turbo run clean",
        "dev:turbo": "turbo run dev --parallel",
        "build:turbo": "turbo run build",
        "lint:turbo": "turbo run lint",
        "test:turbo": "turbo run test",
        "type-check:turbo": "turbo run type-check",
        "delegate": "node scripts/matrix_delegate.js",
        "upgrade:videos": "node scripts/tools/video_upgrade_playbook.cjs all",
        "upgrade:web3d": "node scripts/tools/video_upgrade_playbook.cjs web3d",
        "upgrade:mobile": "node scripts/tools/video_upgrade_playbook.cjs mobile",
        "upgrade:quality": "node scripts/tools/video_upgrade_playbook.cjs quality",
        "cap:list": "node scripts/tools/trigger_capability.js list",
        "cap:show": "node scripts/tools/trigger_capability.js show",
        "cap:run": "node scripts/tools/trigger_capability.js run",
        "cap:gate": "node scripts/tools/trigger_capability.js gate",
        "skills:sync": "powershell -ExecutionPolicy Bypass -File scripts\\tools\\sync_codex_skills.ps1 -Force",
        "skills:sync:dry": "powershell -ExecutionPolicy Bypass -File scripts\\tools\\sync_codex_skills.ps1 -DryRun",
        "skills:doctor": "powershell -ExecutionPolicy Bypass -File scripts\\tools\\skills_doctor.ps1",
        "skills:repair": "powershell -ExecutionPolicy Bypass -File scripts\\tools\\skills_repair.ps1",
        "scan:collab": "node scripts/tools/collab_scan.cjs",
        "fabric:collab": "node scripts/tools/collab_fabric.cjs --mode auto",
        "fabric:collab:execute": "node scripts/tools/collab_fabric.cjs --mode auto --execute-final",
        "fabric:collab:bridge-off": "node scripts/tools/collab_fabric.cjs --mode auto --bridge off",
        "fabric:audit": "node scripts/tools/collab_fabric.cjs --mode collab --workflow matrix-audit",
        "fabric:skills": "node scripts/tools/collab_fabric.cjs --mode collab --workflow skills-ops",
        "generate:api": "kilocode generate api --config kilocode.config.js",
        "generate:component": "kilocode generate component --config kilocode.config.js",
        "generate:hook": "kilocode generate hook --config kilocode.config.js",
        "generate:schema": "kilocode generate schema --config kilocode.config.js",
        "generate:types": "kilocode generate types --config kilocode.config.js",
        "scaffold:feature": "kilocode scaffold --config kilocode.config.js",
        "matrix:type-check": "npm run type-check:turbo",
        "matrix:lint": "npm run lint:turbo",
        "matrix:build": "npm run build:turbo",
        "matrix:start": "npm run start",
        "docs:api": "node scripts/tools/generate_api_docs.cjs",
        "matrix:test": "npm run test:turbo",
        "test:apps": "npm run test --workspace reflect && npm run test --workspace citadel && npm run test --workspace nexus && npm run test --workspace rocket-command-pro && npm run test --workspace ghost-command",
        "storybook:build": "storybook build",
        "metrics:snapshot": "node scripts/tools/metrics_snapshot.cjs",
        "storybook": "storybook dev -p 6006",
        "cache:redis:check": "node scripts/tools/redis_cache_check.cjs",
        "ops:autopilot": "node scripts/tools/ops_autopilot.cjs",
        "ops:autopilot:heal": "node scripts/tools/ops_autopilot.cjs --heal",
        "ops:autopilot:quick": "node scripts/tools/ops_autopilot.cjs --quick",
        "ops:recover": "node scripts/tools/trigger_emergency_recover.js",
        "ops:daemon": "node scripts/tools/autopilot_daemon.cjs --interval-min=15",
        "ops:maintenance:weekly": "npm run stop && npm run clean && npm run ops:autopilot:heal && npm run verify:all && npm run start",
        "mobile:verify:iphone16plus": "node scripts/tools/mobile_verify_iphone16plus.cjs",
        "mobile:verify:fast": "node scripts/tools/mobile_verify_fast.cjs",
        "mobile:verify:fast:nexus": "node scripts/tools/mobile_verify_fast.cjs --app=nexus",
        "mobile:verify:fast:reflect": "node scripts/tools/mobile_verify_fast.cjs --app=reflect",
        "mobile:verify:matrix": "node scripts/tools/mobile_verify_matrix_fast.cjs --app=all",
        "mobile:verify:matrix:ultra": "node scripts/tools/mobile_verify_matrix_fast.cjs --app=all --ultra --timeout-ms=15000 --no-screenshots",
        "mobile:verify:matrix:nexus": "node scripts/tools/mobile_verify_matrix_fast.cjs --app=nexus",
        "mobile:verify:matrix:nexus:ultra": "node scripts/tools/mobile_verify_matrix_fast.cjs --app=nexus --ultra --timeout-ms=12000 --no-screenshots",
        "mobile:verify:matrix:reflect": "node scripts/tools/mobile_verify_matrix_fast.cjs --app=reflect",
        "mobile:verify:matrix:reflect:ultra": "node scripts/tools/mobile_verify_matrix_fast.cjs --app=reflect --ultra --timeout-ms=12000 --no-screenshots",
        "mobile:verify:matrix:ghost": "node scripts/tools/mobile_verify_matrix_fast.cjs --app=ghost",
        "mobile:verify:matrix:ghost:ultra": "node scripts/tools/mobile_verify_matrix_fast.cjs --app=ghost --ultra --timeout-ms=12000 --no-screenshots",
        "mobile:verify:matrix:citadel": "node scripts/tools/mobile_verify_matrix_fast.cjs --app=citadel",
        "mobile:verify:matrix:citadel:ultra": "node scripts/tools/mobile_verify_matrix_fast.cjs --app=citadel --ultra --timeout-ms=12000 --no-screenshots",
        "mobile:verify:matrix:rocket": "node scripts/tools/mobile_verify_matrix_fast.cjs --app=rocket",
        "mobile:verify:matrix:rocket:ultra": "node scripts/tools/mobile_verify_matrix_fast.cjs --app=rocket --ultra --timeout-ms=12000 --no-screenshots",
        "certify:apps": "node scripts/tools/app_certification.cjs --app=all",
        "certify:apps:quick": "node scripts/tools/app_certification.cjs --app=all",
        "certify:apps:full": "node scripts/tools/app_certification.cjs --app=all --full",
        "certify:apps:failed": "node scripts/tools/app_certification.cjs --failed-only",
        "certify:apps:failed:full": "node scripts/tools/app_certification.cjs --failed-only --full",
        "certify:rapid": "node scripts/tools/certify_rapid.cjs --max-attempts=2",
        "certify:rapid:full": "node scripts/tools/certify_rapid.cjs --max-attempts=2 --full",
        "certify:triage": "node scripts/tools/cert_failure_triage.cjs",
        "env:bootstrap": "node scripts/tools/env_manager.cjs bootstrap",
        "env:bootstrap:force": "node scripts/tools/env_manager.cjs bootstrap --force",
        "env:check": "node scripts/tools/env_manager.cjs check",
        "cloud:preflight": "node scripts/tools/cloud_preflight.cjs",
        "cloud:recover:test": "node scripts/tools/cloud_preflight.cjs --recover",
        "cloud:dispatch:test": "node scripts/tools/cloud_preflight.cjs --dispatch",
        "cloud:recover:auto": "node scripts/tools/cloud_preflight.cjs --recover --skip-github",
        "cloud:control:status": "node scripts/tools/cloud_only_control.cjs status",
        "cloud:control:enforce": "node scripts/tools/cloud_only_control.cjs enforce",
        "cloud:control:ignite": "node scripts/tools/cloud_only_control.cjs ignite",
        "cloud:control:heartbeat": "node scripts/tools/cloud_only_control.cjs heartbeat",
        "cloud:control:build": "node scripts/tools/cloud_only_control.cjs build",
        "cloud:control:troubleshoot": "node scripts/tools/cloud_only_control.cjs troubleshoot",
