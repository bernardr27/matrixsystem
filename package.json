        "local:guard:no-listeners": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\tools\\guard_no_local_listeners.ps1",
        "local:disable:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\tools\\disable_local_autostart.ps1",
        "cloud:self-heal": "node scripts/tools/cloud_self_heal_daemon.cjs --interval-sec=30 --stale-sec=120",
        "cloud:self-heal:once": "node scripts/tools/cloud_self_heal_daemon.cjs --once",
        "cloud:self-heal:install-task": "powershell -ExecutionPolicy Bypass -File scripts\\tools\\install_cloud_self_heal_task.ps1",
        "cloud:self-heal:install-startup": "powershell -ExecutionPolicy Bypass -File scripts\\tools\\install_cloud_self_heal_startup.ps1",
        "cloud:oracle:runbook": "echo See docs/CLOUD_PERMANENT_ORACLE_FREE.md",
        "cloud:oracle:verify": "bash infra/oracle-free/verify_oracle_free.sh",
        "cloud:aws:runbook": "echo See docs/CLOUD_PERMANENT_AWS_EC2.md",
        "cloud:aws:verify": "bash infra/aws-ec2/verify_aws_ec2.sh",
        "cloud:aws:update": "bash infra/aws-ec2/update_aws_ec2.sh",
        "cloud:aws:install": "bash infra/aws-ec2/install_aws_ec2.sh",
        "workflow:list": "node scripts/tools/workflow_recipes.cjs list",
        "workflow:run": "node scripts/tools/workflow_recipes.cjs run",
        "command:bus": "node scripts/tools/matrix_command_bus.cjs",
        "diag:heartbeat": "node scripts/tools/diagnostics_core.cjs heartbeat --limit=25",
        "diag:bridge": "node scripts/tools/diagnostics_core.cjs bridge-audit --limit=50",
        "diag:schema": "node scripts/tools/diagnostics_core.cjs schema-audit --limit=50",
        "diag:slo:guard": "node scripts/tools/slo_guard.cjs --stale-sec=120",
        "diag:credentials": "node scripts/tools/credential_doctor.cjs",
        "diag:slo": "node scripts/tools/slo_dashboard.cjs",
        "diag:connectors": "node scripts/tools/connector_health_dashboard.cjs",
        "diag:kpi": "node scripts/tools/kpi_dashboard.cjs",
        "diag:ui:visual": "node scripts/tools/ui_visual_audit.cjs",
        "diag:icons": "node scripts/tools/check_citadel_icons.cjs",
        "diag:workspaces": "node scripts/tools/workspace_consistency_guard.cjs",
        "ops:bridge:hygiene": "node scripts/tools/bridge_hygiene.cjs --stale-hours=2 --failed-days=3",
        "diag:artifacts:hygiene": "node scripts/tools/artifact_hygiene.cjs --days=14",
        "db:migrate:observability": "echo Apply scripts/migrations/observability_tables.sql in Supabase SQL editor or migration runner",
        "test:cloud-boot": "node scripts/tests/cloud_boot_sequence.cjs",
        "certify:release": "node scripts/tools/release_certify.cjs",
        "prod:readiness": "node scripts/tools/prod_readiness_check.cjs",
        "turbopack:validate": "node scripts/tools/validate_turbopack_matrix.cjs",
        "db:migrate:perf-indexes": "echo Apply scripts/migrations/performance_indexes.sql in Supabase SQL editor or migration runner",
        "matrix:analyze": "npm run analyze --workspace citadel && npm run analyze --workspace nexus && npm run analyze --workspace rocket-command-pro && npm run analyze --workspace ghost-command && npm run analyze --workspace reflect",
        "verify:all": "npm run env:check && npm run prod:readiness && npm run lint:turbo && npm run type-check:turbo && npm run diag:icons && npm run diag:workspaces && npm run test:turbo",
        "collab:all": "npm run fabric:audit && npm run fabric:skills"
    },
    "workspaces": [
        "apps/*",
        "libs/matrix-lib/*"
    ],
