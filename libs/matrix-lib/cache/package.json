{
  "name": "@matrix-lib/cache",
  "version": "1.0.0",
  "description": "Shared caching primitives for Matrix V9 (memory + optional Redis)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cache",
    "redis",
    "matrix",
    "singularity"
  ],
  "author": "Matrix Development Team",
  "license": "MIT",
  "dependencies": {
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20"
  }
}
