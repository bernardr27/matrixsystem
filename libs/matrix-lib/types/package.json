{
  "name": "@matrix-lib/types",
  "version": "1.0.0",
  "description": "Shared TypeScript type definitions for Matrix V9 Singularity",
  "main": "./dist/index.d.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    },
    "./database": {
      "types": "./dist/database.d.ts"
    },
    "./api": {
      "types": "./dist/api.d.ts"
    },
    "./auth": {
      "types": "./dist/auth.d.ts"
    },
    "./models": {
      "types": "./dist/models.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "types",
    "typescript",
    "matrix",
    "singularity",
    "definitions"
  ],
  "author": "Matrix Development Team",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5"
  }
}
