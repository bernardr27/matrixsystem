{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "matrix://runtime/heartbeat.schema.json",
  "title": "Matrix Heartbeat Payload",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "services",
    "uptime",
    "timestamp"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "description": "ISO8601 UTC timestamp."
    },
    "uptime": {
      "type": "number",
      "minimum": 0
    },
    "services": {
      "type": "object",
      "description": "Service states keyed by service name.",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "online",
          "offline",
          "degraded",
          "starting",
          "stopping",
          "unknown"
        ]
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
