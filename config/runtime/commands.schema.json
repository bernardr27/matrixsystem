{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "matrix://runtime/commands.schema.json",
  "title": "Matrix System Command",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "command",
    "source",
    "status"
  ],
  "properties": {
    "command": {
      "type": "string",
      "description": "System command string, usually prefixed with sys:."
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "executing",
        "completed",
        "failed",
        "silent"
      ]
    },
    "output": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "description": "ISO8601 UTC timestamp."
    }
  }
}
