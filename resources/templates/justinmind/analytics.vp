                                                <div class="texto col-12" style='max-width:660px;'><p>Are you still not seeing the dialog? <a id="file-download" href="">Click here</a><br />
<script class="noextract">
function findGetParameter(parameterName) {
    var result = null,
        tmp = [];
    location.search
        .substr(1)
        .split("&")
        .forEach(function (item) {
          tmp = item.split("=");
          if (tmp[0] === parameterName) result = decodeURIComponent(tmp[1]);
        });
    return result;
}
setTimeout(function () {
  var lic=findGetParameter('licenseNumber');
  var url=findGetParameter('url');
  var link=findGetParameter('link');
  if(lic){
    var hash=findGetParameter('hash');
    var activationUrl="https://www.justinmind.com/backend/activatelicense?number=" + lic + "&hash=" + hash;
    $('#file-download').attr("href", activationUrl);
    window.location.href="justinmindapp://" + activationUrl;
  }
  else if(url){
    $('#file-download').attr("href","https://download.justinmind.com" + url);
    window.location.href="justinmindapp://https://download.justinmind.com" + url;
  }
  else if(link){
    var openPrototypeURL = "justinmindapp://link=" + link;
    $('#file-download').attr("href",openPrototypeURL);
    window.location.href=openPrototypeURL;
  }
},250);
</script></p>
